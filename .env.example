# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Both values come from your app on API.NSW (https://api.nsw.gov.au):
# My Apps > your app > the Fuel API product. They are read only by the Netlify
# function, never by Vite, which is why neither has a VITE_ prefix: Vite only
# exposes VITE_-prefixed variables to the browser bundle.

# The app's "API Key" (also called the consumer key / client id).
FUEL_API_KEY=

# The app's "API Secret" (also called the consumer secret / client secret).
FUEL_API_SECRET=

# Queensland (round 15): the token (a GUID) emailed by Fuel Prices Qld; since
# round 18 the Data Publisher Token. Read only by the snapshot-qld function;
# never print or log it. In Netlify: production context only, secret.
QLD_FPD_TOKEN=

# Whether the API serves Queensland's prices; only the exact string "true"
# turns it on. In Netlify: production context only, never deploy previews
# (they are public and read production's Blobs). Locally, for testing only.
QLD_PUBLIC=
